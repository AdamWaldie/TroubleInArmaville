// === MISSION OVERVIEW

overviewText 	= "$STR_TIA_MissionName";	// mission summary
overviewPicture = "ui\TroubleInArmaville.jpg";

// === LOAD SCREEN

loadScreen = "ui\TroubleInArmaville.jpg";
author = "WaldoTheWarfighter"; // Author
onLoadName = "$STR_TIA_MissionName"; // Mission name
// Stamped with the real release version by .github/workflows/release.yml at
// package time (from the git tag) - this committed value only ever shows
// when running straight from the repo, outside of a packaged release.
onLoadMission = "Version dev"; // Description

class Header
{
 	gameType = Coop;
	minPlayers = 1;
	maxPlayers = 128; // Matches the 128 playable units placed in mission.sqm
};

// HUD Setup

#include "ui\common.hpp"
#include "ui\TTTHud.hpp"

enableDebugConsole = 1;
disabledAI = 1;
Saving = 0;

respawn = 2;
respawnDelay = 5800;
respawnTemplates[] = {"Spectator"};

// Corpses carry the "Identify Body" scroll action (Waldo_fnc_onKilled /
// Waldo_fnc_identifyBody) and are a core part of this gamemode's actual
// deduction gameplay - the engine's own corpse-cleanup defaults are tuned
// for a normal shooter (a handful of seconds after a low corpseLimit is
// exceeded) and were silently deleting bodies, action and all, well before
// anyone could realistically reach and use them. Nothing in this mission
// ever overrode these, so it was running on those defaults the whole time.
// corpseLimit comfortably exceeds maxPlayers (128) so the count-based
// trigger never fires; the min/max removal times give a corpse the length
// of a full round (base + bonuses can run several minutes) before the
// engine's own timer-based cleanup can claim it either.
corpseLimit = 150;
corpseRemovalMinTime = 900;
corpseRemovalMaxTime = 1200;

