	class lootPower {                       // 26
		title = "$STR_TIA_Param_lootPower";
		values[] = {0, 1, 2};
		texts[]  = {"$STR_TIA_Param_lootPower_0", "$STR_TIA_Param_lootPower_1", "$STR_TIA_Param_lootPower_2"};
		default  = 1;
	};

	// === ENVIRONMENT ===
	class allowRain {                       // 27
		title = "$STR_TIA_Param_allowRain";
		values[] = {0, 1};
		texts[]  = {"$STR_TIA_Param_No", "$STR_TIA_Param_Yes"};
		default  = 1;
	};
	class chanceRain {                      // 28
		title = "$STR_TIA_Param_chanceRain";
		values[] = {0, 20, 40, 60, 80, 100};
		texts[]  = {"0%", "20%", "40%", "60%", "80%", "100%"};
		default  = 40;
	};
	class allowFog {                        // 29
		title = "$STR_TIA_Param_allowFog";
