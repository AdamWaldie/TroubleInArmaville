// ============================================================================
// Function library — compiles functions/**/fn_*.sqf into Waldo_fnc_<name>.
// Branding: Waldo's Mission Pack. See functions/README.md for the layout.
// ============================================================================
class CfgFunctions
{
	class Waldo
	{
		class lang
		{
			file = "functions\lang";
			class localize {};          // Waldo_fnc_localize (shared: resolves STR_TIA_ keys / [fmt, args] in the local client's language)
			class chat {};              // Waldo_fnc_chat (client: localised systemChat, remoteExec target for server-built lines)
			class hintL {};             // Waldo_fnc_hintL (client: localised hint/hintSilent, remoteExec target for server-built hints)
			class addActionL {};        // Waldo_fnc_addActionL (client: addAction with a per-client localised title, remoteExec target in place of "addAction")
		};

		class config
		{
			file = "functions\config";
			class loadParams {};        // Waldo_fnc_loadParams   (server: params + equipment)
			class buildArsenal {};      // Waldo_fnc_buildArsenal (server: dynamic intent-aware gear)
		};

		class core
		{
			file = "functions\core";
			class resetState {};        // Waldo_fnc_resetState  (idempotent round (re)init)
			class initServer {};        // Waldo_fnc_initServer  (round orchestrator)
			class initClient {};        // Waldo_fnc_initClient  (per-client setup)
			class applySpawnLoadout {}; // Waldo_fnc_applySpawnLoadout (random uniform/vest/headgear)
		};

		class arena
		{
			file = "functions\arena";
			class selectArena {};       // Waldo_fnc_selectArena
			class selectHoldingPos {};  // Waldo_fnc_selectHoldingPos (server: fast safe pre-arena spot, any terrain)
			class buildArena {};        // Waldo_fnc_buildArena
			class populateLoot {};      // Waldo_fnc_populateLoot
			class confineToArena {};    // Waldo_fnc_confineToArena
			class clearArenaPaths {};   // Waldo_fnc_clearArenaPaths (server: cuts a gate through any wall/fence line splitting the arena)
		};

		class env
		{
			file = "functions\env";
			class setupWeather {};      // Waldo_fnc_setupWeather
		};

		class round
		{
			file = "functions\round";
			class assignRoles {};       // Waldo_fnc_assignRoles
			class applyDetectiveLoadout {}; // Waldo_fnc_applyDetectiveLoadout
			class startRound {};        // Waldo_fnc_startRound
			class roundLoop {};         // Waldo_fnc_roundLoop
			class checkWin {};          // Waldo_fnc_checkWin
			class endRound {};          // Waldo_fnc_endRound
			class onKilled {};          // Waldo_fnc_onKilled
			class reviveRelink {};      // Waldo_fnc_reviveRelink (server: relinks role/lists onto a revived unit's NEW object)
			class roundMVP {};          // Waldo_fnc_roundMVP (server: finds + broadcasts the MVP)
			class showRoleCard {};      // Waldo_fnc_showRoleCard (client: round-start "who you are / who you know" notification)
		};

		class systems
		{
			file = "functions\systems";
			class spawnAirdrop {};      // Waldo_fnc_spawnAirdrop
			class applyKarma {};        // Waldo_fnc_applyKarma
			class c4Charge {};          // Waldo_fnc_c4Charge (server: traitor timed charge)
			class identifyBody {};      // Waldo_fnc_identifyBody (server: call in a corpse)
			class dnaContaminate {};    // Waldo_fnc_dnaContaminate (server: witness/contamination tracking)
			class spawnDecoyCorpse {};  // Waldo_fnc_spawnDecoyCorpse (server: Dead Ringer decoy)
			class flowerSpawn {};       // Waldo_fnc_flowerSpawn (server: creates one networked flower)
			class setupDeadChatFilter {}; // Waldo_fnc_setupDeadChatFilter (client: blocks alive<->dead text chat)
			class deleteBody {};        // Waldo_fnc_deleteBody (server: Body Remover's actual deletion)
		};

		class ui
		{
			file = "functions\ui";
			class initShops { preInit = 1; }; // defines shop catalogs on every machine
			class initHud {};           // Waldo_fnc_initHud
			class openStylePicker {};   // Waldo_fnc_openStylePicker (H: role crest style picker dialog)
			class topBarTimer {};       // Waldo_fnc_topBarTimer (top bar's round-timer loop, started once)
			class warmupBar {};         // Waldo_fnc_warmupBar (top-bar "Selecting Roles" countdown during warmup)
			class topBarAnnounce {};    // Waldo_fnc_topBarAnnounce (top-bar fade in/out announcement banner)
			class drawRoleIcons {};     // Waldo_fnc_drawRoleIcons
			class openBuyMenu {};       // Waldo_fnc_openBuyMenu
			class buyItem {};           // Waldo_fnc_buyItem
			class titleSequence {};     // Waldo_fnc_titleSequence
			class pregameScreen {};     // Waldo_fnc_pregameScreen
			class scoreboard {};        // Waldo_fnc_scoreboard (in-round scoreboard, K)
			class mvpCelebrate {};      // Waldo_fnc_mvpCelebrate (client: round-end MVP celebration)
			class pingWheelOpen {};     // Waldo_fnc_pingWheelOpen (traitor: hold-T ping picker, opens)
			class pingWheelRender {};   // Waldo_fnc_pingWheelRender (traitor: redraw the ping picker highlight)
			class pingWheelClose {};    // Waldo_fnc_pingWheelClose (traitor: T released, fires the highlighted ping)
			class useActivationSlot {};    // Waldo_fnc_useActivationSlot (fires the item bound to Y/U/J)
			class assignActivationSlot {}; // Waldo_fnc_assignActivationSlot (buy menu: rebind an item to a key)
			class registerActivationSlot {}; // Waldo_fnc_registerActivationSlot (shared: slot/backlog assignment)
			class consumeActivationItem {}; // Waldo_fnc_consumeActivationItem (shared: clear a slot + promote backlog, for items whose "used?" outcome resolves asynchronously - see Disguiser)
			class setupBriefing {};        // Waldo_fnc_setupBriefing (client: "How To Play" map-screen diary)
			class roleBriefingText {};     // Waldo_fnc_roleBriefingText (shared: builds the "who you are/who you know" text for the round-start card AND the scoreboard's Your Briefing panel)
		};

		// Vendored from AdamWaldie/WaldosMissionPack (MissionScripts/MissionFlowAndUi,
		// commit 3109e52) - the reusable WMP notification-card system, unmodified.
		// Deliberately its own class/folder (not merged into `ui` above) so future
		// pulls from the source repo are a clean file copy, not a merge against
		// this mission's own UI code. Class names keep the source's PascalCase
		// Waldo_fnc_* API exactly (SQF identifiers are case-insensitive, so this
		// doesn't collide with this mission's own lowerCamelCase convention) so
		// they match that pack's own documentation/wiki. Only the two files that
		// are pure vanilla SQF with no CBA/ACE calls at all were worth pulling in
		// for what this mission actually needs (queued/placed notification
		// cards); fn_setupUiCleanupAction.sqf is the one exception and is safe
		// regardless - it already detects ACE's absence and falls back to a
		// vanilla addAction on its own.
		class uinotify
		{
			file = "functions\uinotify";
			class ShowUiNotification {};        // Waldo_fnc_ShowUiNotification
			class ShowUiNotificationAll {};     // Waldo_fnc_ShowUiNotificationAll (mission-specific, not vendored - broadcasts per-player instead of remoteExec's "-2", which was confirmed to silently never deliver on this mission's hosting setup)
			class DismissUiNotification {};     // Waldo_fnc_DismissUiNotification
			class DrainUiNotificationQueue {};  // Waldo_fnc_DrainUiNotificationQueue
			class ResolveUiPanelPlacement {};   // Waldo_fnc_ResolveUiPanelPlacement
			class ReflowUiPanels {};            // Waldo_fnc_ReflowUiPanels
			class SetUiPanelPlacement {};       // Waldo_fnc_SetUiPanelPlacement
			class SetLocalUiPanelPlacement {};  // Waldo_fnc_SetLocalUiPanelPlacement
			class ClearUiPanels {};             // Waldo_fnc_ClearUiPanels
			class CleanupTransientUi {};        // Waldo_fnc_CleanupTransientUi
			class SetupUiCleanupAction {};      // Waldo_fnc_SetupUiCleanupAction (ACE self-action, vanilla addAction fallback)
		};

		class debug
		{
			file = "functions\debug";
			class debugInit { preInit = 1; };  // builds the extensible test-action registry + API
			class debugMenu {};                // Waldo_fnc_debugMenu (client: renders the registry)
			class debugExec {};                // Waldo_fnc_debugExec (server: runs a server action by index)
			class effectivePlayerCount {};     // Waldo_fnc_effectivePlayerCount (size scaling + sim override)
		};

		class roles
		{
			file = "functions\roles";
			class traitorRadar {};      // Waldo_fnc_traitorRadar
			class detectiveRadar {};    // Waldo_fnc_detectiveRadar
			class radarCountdown {};    // Waldo_fnc_radarCountdown (client: "next pulse in Xs" corner label)
			class warpSmoke {};         // Waldo_fnc_warpSmoke
			class suicideBomb {};       // Waldo_fnc_suicideBomb
			class flowerPower {};       // Waldo_fnc_flowerPower
			class tester {};            // Waldo_fnc_tester
			class makeJester {};        // Waldo_fnc_makeJester
			class unmakeJester {};      // Waldo_fnc_unmakeJester (removes the fire-block on role switch)
			class revive {};            // Waldo_fnc_revive
			class healthStation {};     // Waldo_fnc_healthStation
			class fakeHealthStation {};      // Waldo_fnc_fakeHealthStation (traitor decoy trap)
			class fakeHealthStationBoom {};  // Waldo_fnc_fakeHealthStationBoom (server: detonates the decoy)
			class holster {};           // Waldo_fnc_holster
			class removeBody {};        // Waldo_fnc_removeBody (traitor: destroy a corpse)
			class dnaScanner {};        // Waldo_fnc_dnaScanner (detective: track a killer)
			class placeC4 {};           // Waldo_fnc_placeC4 (traitor: place a timed charge)
			class traitorPing {};       // Waldo_fnc_traitorPing (traitor: silent coordination ping)
			class pingShow {};          // Waldo_fnc_pingShow (client: render a traitor ping)
			class deadRinger {};        // Waldo_fnc_deadRinger (traitor: arm a faked death)
			class deadRingerTrigger {}; // Waldo_fnc_deadRingerTrigger (client: sell the fake death)
			class disguiserOpen {};     // Waldo_fnc_disguiserOpen (traitor: opens the target-picker dialog)
			class disguiserActivate {}; // Waldo_fnc_disguiserActivate (traitor: applies the loadout copy, runs the 60s countdown/revert)
		};
	};
};

class Params {
	// Params are read by INDEX in Waldo_fnc_loadParams; this block's ORDER is the
	// index. If you reorder or insert, update the reads there to match. Booleans
	// use {0,1} + a numeric read (a {False,True} value with a bool default is
	// ignored by the engine).
	//
	// Reorganised into logical groups (2026-08-01): every param added since this
	// mission first shipped had been tacked on at the very end to avoid
	// reindexing (Arma's lobby stores a param SELECTION by index, so renumbering
	// changes what an already-saved server config/preset actually picks) - which
	// meant, for example, "Jester: Minimum Players" showed up nowhere near the
	// rest of the Jester settings in the actual lobby Parameters list, since
	// that screen just renders this block in file order with no grouping of its
	// own. This is a one-time clean renumber to fix that. Genuinely breaking:
	// any already-saved lobby parameter preset now points at the WRONG setting
	// by index and must be reselected once - accepted deliberately here, but
	// don't reorder casually again afterward.

	// === ROUND ===
	class roundBaseLength {                 // 0
		title = "$STR_TIA_Param_roundBaseLength";
		values[] = {120, 150, 180, 210, 240};
		texts[]  = {"120", "150", "180", "210", "240"};
		default  = 180;
	};
	class roundPlayerLength {               // 1
		title = "$STR_TIA_Param_roundPlayerLength";
		values[] = {15, 30, 45};
		texts[]  = {"15", "30", "45"};
		default  = 30;
	};
	class roundTraitorLength {              // 2
		title = "$STR_TIA_Param_roundTraitorLength";
		values[] = {30, 45, 60};
		texts[]  = {"30", "45", "60"};
		default  = 45;
	};
	class roundDeadLength {                 // 3
		title = "$STR_TIA_Param_roundDeadLength";
		values[] = {15, 30, 45};
		texts[]  = {"15", "30", "45"};
		default  = 30;
	};
	class roundWarmupLength {               // 4
		title = "$STR_TIA_Param_roundWarmupLength";
		values[] = {10, 20, 30, 45};
		texts[]  = {"10", "20", "30", "45"};
		default  = 20;
	};

	// === ROLES ===
	class TraitorPercentageChanceLowerBound {   // 5
		// Renamed from "Traitor Chance Lower/Upper Bound" - the old titles
		// didn't say these two work TOGETHER as a range assignRoles rolls a
		// random percentage from, which read as two unrelated settings
		// rather than a min/max pair.
		title = "$STR_TIA_Param_TraitorPercentageChanceLowerBound";
		values[] = {20, 25, 30, 40};
		texts[]  = {"20%", "25%", "30%", "40%"};
		default  = 25;
	};
	class TraitorPercentageChanceHigherBound {  // 6
		title = "$STR_TIA_Param_TraitorPercentageChanceHigherBound";
		values[] = {40, 45, 50, 60};
		texts[]  = {"40%", "45%", "50%", "60%"};
		default  = 45;
	};
	class minTraitors {                     // 7
		title = "$STR_TIA_Param_minTraitors";
		values[] = {1, 2, 3};
		texts[]  = {"1", "2", "3"};
		default  = 1;
	};
	class maxTraitors {                     // 8
		title = "$STR_TIA_Param_maxTraitors";
		values[] = {0, 2, 3, 4, 5, 8};
		texts[]  = {"$STR_TIA_Param_Unlimited", "2", "3", "4", "5", "8"};
		default  = 0;
	};
	class DetectiveEnabled {                // 9
		title = "$STR_TIA_Param_DetectiveEnabled";
		values[] = {0, 1};
		texts[]  = {"$STR_TIA_Param_Disabled", "$STR_TIA_Param_Enabled"};
		default  = 1;
	};
	class DetectiveMinPlayers {             // 10
		title = "$STR_TIA_Param_DetectiveMinPlayers";
		values[] = {3, 4, 5, 6, 8};
		texts[]  = {"3", "4", "5", "6", "8"};
		default  = 5;
	};
	class JesterEnabled {                   // 11
		title = "$STR_TIA_Param_JesterEnabled";
		values[] = {0, 1};
		texts[]  = {"$STR_TIA_Param_Disabled", "$STR_TIA_Param_Enabled"};
		default  = 1;   // one of the four documented roles - on by default, not opt-in
	};
	class JesterMinPlayers {                // 12
		// Moved up next to the rest of the Jester settings - was stranded at
		// the very end of the list (appended after this param existed).
		title = "$STR_TIA_Param_JesterMinPlayers";
		values[] = {5, 6, 8, 10, 12};
		texts[]  = {"5", "6", "8", "10", "12"};
		default  = 10;
	};
	class JesterAlways {                    // 13
		title = "$STR_TIA_Param_JesterAlways";
		values[] = {0, 1};
		texts[]  = {"$STR_TIA_Param_JesterAlways_0", "$STR_TIA_Param_Yes"};
		default  = 0;
	};
	class JesterPercentagechance {          // 14
		title = "$STR_TIA_Param_JesterPercentagechance";
		values[] = {20, 30, 40};
		texts[]  = {"20%", "30%", "40%"};
		default  = 30;
	};
	class spectatorsSeeAllRoles {           // 15
		// Grouped with Roles, not Gameplay - this is entirely about role
		// visibility, same family as everything else in this section.
		title = "$STR_TIA_Param_spectatorsSeeAllRoles";
		values[] = {0, 1};
		// Off by default: a dead player broadcasting every living role to
		// anyone they still talk to (or just narrating what they see) leaks
		// exactly the information the round is built around. Off still
		// falls through to each spectator's own per-role visibility (own
		// team, the public Detective) rather than hiding everything - see
		// Waldo_fnc_drawRoleIcons/Waldo_fnc_scoreboard.
		texts[]  = {"$STR_TIA_Param_spectatorsSeeAllRoles_0", "$STR_TIA_Param_spectatorsSeeAllRoles_1"};
		default  = 0;
	};

	// === GAMEPLAY / ECONOMY ===
	class KarmaEnabled {                    // 16
		title = "$STR_TIA_Param_KarmaEnabled";
		values[] = {0, 1};
		texts[]  = {"$STR_TIA_Param_Disabled", "$STR_TIA_Param_Enabled"};
		default  = 1;
	};
	class startingCredits {                 // 17
		title = "$STR_TIA_Param_startingCredits";
		values[] = {0, 1, 2, 3, 5};
		texts[]  = {"0", "1", "2", "3", "5"};
		default  = 1;
	};
	class startCreditsPerNPlayers {         // 18
		// Moved up next to the base credits setting it scales - was
		// stranded at the very end of the list.
		title = "$STR_TIA_Param_startCreditsPerNPlayers";
		values[] = {4, 5, 6, 8, 10, 12};
		texts[]  = {"4", "5", "6", "8", "10", "12"};
		default  = 8;
	};
	class killRewardCredits {               // 19
		title = "$STR_TIA_Param_killRewardCredits";
		values[] = {0, 1, 2, 3};
		texts[]  = {"$STR_TIA_Param_ZeroOff", "1", "2", "3"};
		default  = 1;
	};
	class civKillBonusEvery {               // 20
		title = "$STR_TIA_Param_civKillBonusEvery";
		values[] = {0, 3, 5, 8};
		texts[]  = {"$STR_TIA_Param_Off", "$STR_TIA_Param_civKillBonusEvery_1", "$STR_TIA_Param_civKillBonusEvery_2", "$STR_TIA_Param_civKillBonusEvery_3"};
		default  = 5;
	};

	// === AIRDROP / LOOT ===
	class airdrop {                         // 21
		title = "$STR_TIA_Param_airdrop";
		values[] = {0, 1};
		texts[]  = {"$STR_TIA_Param_Disabled", "$STR_TIA_Param_Enabled"};
		default  = 1;
	};
	class airdropBaseTimer {                // 22
		title = "$STR_TIA_Param_airdropBaseTimer";
		values[] = {30, 60, 75, 90, 120};
		texts[]  = {"30", "60", "75", "90", "120"};
		default  = 75;
	};
	class airdropRandomTimer {              // 23
		title = "$STR_TIA_Param_airdropRandomTimer";
		values[] = {0, 30, 60, 75, 90};
		texts[]  = {"0", "30", "60", "75", "90"};
		default  = 75;
	};
	class airdropLoadoutsAmount {           // 24
		title = "$STR_TIA_Param_airdropLoadoutsAmount";
		values[] = {1, 2, 3};
		texts[]  = {"1", "2", "3"};
		default  = 1;
	};
	class lootMaxBullets {                  // 25
		title = "$STR_TIA_Param_lootMaxBullets";
		values[] = {30, 40, 50, 60, 75, 100};
		texts[]  = {"30", "40", "50", "60", "75", "100"};
		default  = 50;
