		values[] = {0, 1};
		texts[]  = {"$STR_TIA_Param_No", "$STR_TIA_Param_Yes"};
		default  = 0;
	};

	// === PENALTIES === (appended 2026-08-01, per the note at the top of this
	// block - new params go at the end from here on, not inserted by group)
	class jesterKillPenalty {               // 34
		// This is the number of credits LEFT after the penalty, not an amount
		// deducted - killing the Jester is a hard mistake (loses the round
		// outright for the culprit's team, see Waldo_fnc_onKilled), so it
		// strips a Traitor down to this floor no matter how many credits
		// they'd banked up, rather than subtracting a fixed amount a
		// well-stocked Traitor could shrug off. Default 1 matches Radar's
		// cost exactly, so the culprit can always still afford it afterward.
		title = "$STR_TIA_Param_jesterKillPenalty";
		values[] = {0, 1, 2, 3};
		texts[]  = {"0", "$STR_TIA_Param_jesterKillPenalty_1", "2", "3"};
		default  = 1;
	};
	class traitorTeamkillPenalty {          // 35
		// Small compared to jesterKillPenalty on purpose - a Traitor killing a
		// teammate is friendly fire between people who already know each
		// other's role, not a mystery-breaking mistake. Still a real cost (see
		// Waldo_fnc_onKilled) so it's never free, and a small karma hit too.
		title = "$STR_TIA_Param_traitorTeamkillPenalty";
		values[] = {0, 1, 2, 3};
		texts[]  = {"$STR_TIA_Param_ZeroOff", "1", "2", "3"};
		default  = 2;
	};

	// No HUD/role-crest-style param on purpose: that's entirely a per-player
	// preference now (H key, see Waldo_fnc_initHud/fn_initClient.sqf), not
	// something a server admin sets for everyone.
};
